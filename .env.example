# Supabase (required in production)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional
NEXT_PUBLIC_BASE_URL=
# Clerk (optional real auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Support WhatsApp 24/7 (e.g. +243 81 234 5678). Leave empty to hide the WhatsApp button (e-mail form only).
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Web push (optional). If unset, in-app alerts are used.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@apporte.app
